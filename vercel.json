{
  "version": 2,
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    {
      "src": "/sw\\.js",
      "dest": "/sw.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/version\\.json",
      "dest": "/version.json",
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ],
  "outputDirectory": ".",
  "crons": [
    { "path": "/api/reminders-cron", "schedule": "0 13 * * *" },
    { "path": "/api/reminders-cron", "schedule": "0 23 * * *" },
    { "path": "/api/cierre-mensual", "schedule": "1 5 * * *" }
  ]
}
