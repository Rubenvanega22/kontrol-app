{
  "version": 2,
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/sw\\.js", "dest": "/sw.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "outputDirectory": ".",
  "crons": [
    { "path": "/api/sync-emails", "schedule": "0 13 * * *" },
    { "path": "/api/sync-emails", "schedule": "0 17 * * *" },
    { "path": "/api/sync-emails", "schedule": "0 21 * * *" },
    { "path": "/api/sync-emails", "schedule": "0 1 * * *" },
    { "path": "/api/ai-analysis", "schedule": "0 9 * * *" },
    { "path": "/api/reminders-cron", "schedule": "0 13 * * *" }
  ]
}
